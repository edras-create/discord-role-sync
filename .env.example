# Keep the bot token secret. Never commit a real value.
DISCORD_BOT_TOKEN=replace_with_your_bot_token

# Required Discord snowflake IDs.
DISCORD_SERVER_ID=123456789012345678
DISCORD_MESSAGE_ID=123456789012345678
DISCORD_ROLE_ID=123456789012345678

# Required: ADD or REMOVE.
DISCORD_ACTION=ADD

# Optional but recommended. When omitted, readable text channels are scanned.
DISCORD_CHANNEL_ID=123456789012345678

# Optional: auto, reactions, or poll. Default: auto.
DISCORD_SOURCE=auto

# Optional safety switch. true logs changes without applying them.
DISCORD_DRY_RUN=false

